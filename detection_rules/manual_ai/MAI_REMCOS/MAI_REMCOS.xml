<group name="MAI_REMCOS_DET_1">
    <rule id="900341" level="12">
        <!-- Author: manual -->
        <!-- Description: Matches when aspnet_compiler.exe loads 32-bit urlmon.dll, specific behaviour to remcos. -->
        <!-- Date: 06/08/2026 -->
        <!-- Status: experimental -->
        <!-- Sigma ID: ee803832-9805-4f33-a4b4-2c4ee204bdeb -->
        <decoded_as>json</decoded_as>
        <field name="SourceName">Microsoft-Windows-Sysmon</field>
        <field name="EventID">^7$</field>
        <field name="Image" type="pcre2">(?i)\\aspnet_compiler\.exe$</field>
        <field name="ImageLoaded" type="pcre2">(?i)\\(SysWOW64|System32)\\urlmon\.dll$</field>
        <description>MAI_REMCOS_DET_1</description>
        <mitre>
            <id>T1036</id>
        </mitre>
    </rule>
</group>

<group name="MAI_REMCOS_DET_2">
    <rule id="900342" level="12">
        <!-- Author: manual -->
        <!-- Description: Detecs a DNS query for specifically used remcos domain c2. -->
        <!-- Date: 06/08/2026 -->
        <!-- Status: experimental -->
        <!-- Sigma ID: f4bd3b13-1abd-43c9-a8ed-b02f412c819a -->
        <decoded_as>json</decoded_as>
        <field name="SourceName">Microsoft-Windows-Sysmon</field>
        <field name="EventID">^22$</field>
        <field name="Image" type="pcre2">(?i)\\aspnet_compiler\.exe$</field>
        <field name="QueryName" type="pcre2">(?i)^ruffyayeaye\.ddns\.net\.?$</field>
        <description>MAI_REMCOS_DET_2</description>
        <mitre>
            <id>T1614</id>
            <id>T1627.001</id>
        </mitre>
    </rule>
</group>

<group name="MAI_REMCOS_CORR">
    <rule id="900343" level="12" timeframe="120">
        <!-- Author: Manual AI -->
        <!-- Description: Correlates MAI_REMCOS_DET_1 and MAI_REMCOS_DET_2 when 2 follows 1 within 2 minutes. -->
        <!-- Status: experimental -->
        <!-- Sigma ID: fb9eafaa-b6a5-493d-9078-76bdd2243713 -->
        <if_matched_sid>900341</if_matched_sid>
        <if_sid>900342</if_sid>
        <description>MAI_REMCOS_CORR</description>
        <mitre>
            <id>T1036</id>
            <id>T1614</id>
            <id>T1627.001</id>
        </mitre>
    </rule>
</group>
