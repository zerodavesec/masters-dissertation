<group name="MAI_AKIRA_DET_1,">
    <!-- Akira logfile matcher -->
    <rule id="900100" level="0" noalert="1">
        <decoded_as>json</decoded_as>
        <field name="SourceName">Microsoft-Windows-Sysmon</field>
        <field name="EventID">^11$</field>
        <field name="Image" type="pcre2">(?i)\.exe$</field>
        <field name="TargetFilename" type="pcre2">(?i)\\Log-(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-\d{4}-([01][0-9]|2[0-3])-([0-5][0-9])-([0-5][0-9])\.txt$</field>
        <field name="Image" type="pcre2">(?i)(Desktop|Users)</field>
        <description>Akira log file created</description>
    </rule>

    <!-- Akira ransomnote matcher -->
    <rule id="900101" level="0" noalert="1">
        <decoded_as>json</decoded_as>
        <field name="SourceName">Microsoft-Windows-Sysmon</field>
        <field name="EventID">^11$</field>
        <field name="Image" type="pcre2">(?i)\.exe$</field>
        <field name="TargetFilename" type="pcre2">(?i)\\akira_readme\.txt$</field>
        <field name="TargetFilename" type="pcre2">(?i)(PerfLogs|Desktop)</field>
        <description>Akira ransom note created</description>
    </rule>

    <!-- Final alert -->
    <!-- Author: Manual -->
    <!-- Description: Identifies when a regex pattern that matches the log file from akira, or an akira readme TXT file is dropped in known places. -->
    <!-- Date: 06/08/2026 -->
    <!-- Status: experimental -->
    <!-- Sigma ID: b70b7717-815b-4dc4-b2d2-13ed74321a2a -->
    <rule id="900102" level="12">
        <if_sid>900100,900101</if_sid>
        <description>MAI_AKIRA_DET_1</description>
        <mitre>
            <id>T1486</id>
        </mitre>
    </rule>
</group>


<group name="MAI_AKIRA_DET_2,">
    <!-- Author: Manual -->
    <!-- Description: Identifies when powershell is being used to remove shadowcopy. Ransomware indicator. -->
    <!-- Date: 06/08/2026 -->
    <!-- Status: experimental -->
    <!-- Sigma ID: b42a6f3e-8fbc-4c52-8047-14731e264fed -->
    <rule id="900103" level="12">
        <decoded_as>json</decoded_as>
        <field name="SourceName">Microsoft-Windows-Sysmon</field>
        <field name="EventID">^1$</field>
        <field name="Image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
        <field name="CommandLine" type="pcre2">(?i)Get\-WmiObject</field>
        <field name="CommandLine" type="pcre2">(?i)shadowcopy</field>
        <field name="CommandLine" type="pcre2">(?i)Remove\-WmiObject</field>
        <description>MAI_AKIRA_DET_2</description>
        <mitre>
            <id>T1490</id>
        </mitre>
    </rule>
</group>


<group name="MAI_AKIRA_CORR,">
    <!-- Sigma ID: 803cb30b-5bc4-4493-af9d-8926fdb953f9 -->
    <!-- Status: experimental -->
    <rule id="900104" level="12" timeframe="60">
        <if_matched_sid>900102</if_matched_sid>
        <if_sid>900103</if_sid>
        <description>MAI_AKIRA_CORR</description>
        <mitre>
            <id>T1486</id>
            <id>T1490</id>
        </mitre>
    </rule>
</group>
